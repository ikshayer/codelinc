# Copy to .env.local. Backend db/serve/demo scripts load that file when present.
# Never commit real values.
# Server-side only (no NEXT_PUBLIC_ prefix).
# synthetic = offline, deterministic adapters (default). live = AWS Bedrock (optional).
AI_MODE=synthetic
AI_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=carewindow
BACKEND_PORT=3001
# Canonical engine persistence uses the same database. Database-backed engine
# startup requires this connection and a successful `npm run db:seed`.
# AWS credentials come from the standard credential chain (profile/SSO/role), not this file.
