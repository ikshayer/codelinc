# Copy to .env.local. Never commit real values. Server-side only (no NEXT_PUBLIC_ prefix).
# synthetic = offline, deterministic adapters (default). live = AWS Bedrock (optional).
AI_MODE=synthetic
AI_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
APP_ORIGIN=http://localhost:3000
# AWS credentials come from the standard credential chain (profile/SSO/role), not this file.
