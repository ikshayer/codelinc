# Copy to .env.local. Backend db/serve/demo scripts load that file when present.
# Never commit real values.
# Server-side only (no NEXT_PUBLIC_ prefix).
# synthetic = offline, deterministic adapters (default). live = AWS Bedrock (optional).
AI_MODE=synthetic
AI_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
APP_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=carewindow
BACKEND_PORT=3001
# Canonical engine persistence uses the same database. Database-backed engine
# startup requires this connection and a successful `npm run db:seed`.

# Voice assistant (independent of the optional AWS extraction adapters)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
VOICE_PORT=3002
CHATTERBOX_URL=http://127.0.0.1:8001
CHATTERBOX_DEVICE=cuda
# Optional local WAV voice reference, >5 seconds. Default uses the model's built-in voice.
# CHATTERBOX_VOICE_PATH=D:/path/to/voice.wav
# VOICE_MANAGE_TTS=false  # only if you start the Python service separately
# AWS credentials come from the standard credential chain (profile/SSO/role), not this file.
