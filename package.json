{
  "name": "codelinc-dental-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "data:generate": "node --import tsx scripts/generate-expanded-demo.ts",
    "db:seed": "node --import tsx scripts/seed-dental-demo.ts",
    "db:verify": "node --import tsx scripts/verify-dental-demo.ts",
    "test:data": "node --import tsx --test tests/*.test.ts",
    "test": "npm run test:data && npm --prefix backend test",
    "test:contracts": "npm --prefix backend run test:contracts",
    "test:acceptance": "npm --prefix backend run test:acceptance",
    "test:integration": "npm --prefix backend run test:integration",
    "test:e2e": "playwright test",
    "check:frozen": "npm --prefix backend run check:frozen",
    "freeze": "npm --prefix backend run freeze",
    "golden:check": "npm --prefix backend run golden:check",
    "demo:cli": "npm --prefix backend run demo:cli",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "backend:lint": "npm --prefix backend run lint",
    "verify": "npm run typecheck && npm run lint && npm run check:frozen && npm run golden:check && npm run backend:typecheck && npm run backend:lint && npm run test:contracts && npm test && npm run test:acceptance && npm run test:integration && npm run build"
  },
  "dependencies": {
    "mongodb": "^6.20.0",
    "zod": "^4.1.11",
    "next": "^16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "@playwright/test": "1.56",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^29.1.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
