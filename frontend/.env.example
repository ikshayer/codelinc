# CareWindow frontend environment. Copy to .env.local. No secrets belong in NEXT_PUBLIC_* variables.

# "demo":           synthetic fixtures, simulated report analysis and conversation,
#                   session-only history, fixture-preview calculations. Always labeled in the UI.
# "live" (default): loads database members and calls backend endpoints.
#                   Missing services report themselves unavailable — nothing falls back to fixtures.
NEXT_PUBLIC_CAREWINDOW_MODE=live
BACKEND_BASE_URL=http://127.0.0.1:3001

# --- Server-side only (used by the backend / Auth.js when it is added; never exposed to the browser) ---
# Google sign-in via Auth.js. This frontend talks to Auth.js's REST routes (/api/auth/*);
# it does not read these values itself.
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
