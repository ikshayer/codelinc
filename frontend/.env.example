# CareWindow frontend environment. Copy to .env.local. No secrets belong in NEXT_PUBLIC_* variables.

# "demo":           synthetic fixtures, simulated report analysis and conversation,
#                   session-only history, fixture-preview calculations. Always labeled in the UI.
# "live" (default): loads database members and calls backend endpoints.
#                   Missing services report themselves unavailable — nothing falls back to fixtures.
NEXT_PUBLIC_CAREWINDOW_MODE=live
BACKEND_BASE_URL=http://127.0.0.1:3001

# --- Server-side only (Auth.js; never exposed to the browser) ---
# Generate a secret with `node scripts/setup-auth-secret.mjs`.
# Create a Google OAuth Web application client and register:
# http://localhost:3000/api/auth/callback/google
# See docs/google-auth.md for the complete setup.
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- Deterministic engine (backend/, `npm run serve`) ---
# The /care-window page calls /api/engine/*, which Next rewrites to this server-side URL.
# Server-only; read at `next dev` / `next build` time.
# CAREWINDOW_ENGINE_URL=http://localhost:4000
# The engine accepts only origins in its ALLOWED_ORIGINS (default http://localhost:3000); set it on the backend if this app runs elsewhere.
# Optional canonical public origin when deploying behind a trusted proxy:
# AUTH_URL=https://your-app.example
# AUTH_TRUST_HOST=true
